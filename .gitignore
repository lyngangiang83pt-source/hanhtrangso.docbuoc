# 1. Các thư mục gói phụ thuộc & Build
node_modules/
dist/
build/
out/
.next/
.cache/

# 2. File môi trường & Khóa bảo mật (Bảo vệ thông tin cá nhân & API Keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# 3. File nhật ký & Tệp tạm thời
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Tệp hệ điều hành & Trình soạn thảo
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# 5. Tệp logs và tiến trình nội bộ
.agent/tasks/
.agent/**/logs/
.agent/.shared/
*.tmp
*.bak
